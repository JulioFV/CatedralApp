{
  "expo": {
    "name": "CatedralApp",
    "slug": "CatedralApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "catedralapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "icon": "./assets/images/icon.png",
      "predictiveBackGestureEnabled": false,
      "package": "com.juliocesarflorentinovigueras.CatedralApp"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/icon.png",
      "bundler":"metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#7A1F1F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9c1cf1e1-a5dc-43f7-8025-c9eefaacab2b"
      }
    }
  }
}
